# ===== BACKEND SECRETS: the ONLY file you edit for the backend =====
# Local run: Spring reads this file automatically (run from the backend/ folder).
# Render: do NOT upload this file. Copy each KEY=VALUE below into Render > Environment.

# 1) MongoDB Atlas connection string (keep /wie_ds before the ?)
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/wie_ds?retryWrites=true&w=majority

# 2) Two different random strings. Generate each with: openssl rand -hex 32
JWT_SECRET=PASTE_RANDOM_STRING_1
JWT_REFRESH_SECRET=PASTE_RANDOM_STRING_2

# 3) Your frontend URL (Vercel). For local testing use http://localhost:5174
CORS_ORIGIN=https://YOUR-APP.vercel.app

# 4) true on the internet (HTTPS), false only on localhost
COOKIE_SECURE=true

# 5) false in production (demo accounts have a public password)
SEED_DEMO=false

# 6) Optional AI keys (leave empty to skip)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
CUSTOM_BOT_URL=
CUSTOM_BOT_KEY=
